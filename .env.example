# GEMINI_API_KEY: Optional/Default for AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / FRONTEND_URL
APP_URL="MY_APP_URL"
FRONTEND_URL="http://localhost:3000"

# MongoDB Database URI (MongoDB Atlas)
# If not provided, an automatic persistent in-memory MongoDB store is used
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/aaproperties?retryWrites=true&w=majority"

# JWT Auth Secrets
JWT_SECRET="aa_properties_kano_jwt_super_secret_key_2026"
JWT_REFRESH_SECRET="aa_properties_kano_refresh_jwt_super_secret_key_2026"

# Cloudinary Image Upload
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="demo_key"
CLOUDINARY_API_SECRET="demo_secret"
